#!/usr/bin/perl

#file: resume.cgi
#########################################################
### cgi to handle info from autogenerated forms
##########################################################
use CGI qw/:standard/; 
# This line is commented since the format interferes with the multi-part format
# of the calling forms param is used instead.

print "Content-type: text/html", "\n\n";

$mailpath = "/usr/local/bin/mutt";
$mainmailto = "jobs\@notwired.com";
$mailto = param('email');
 
$file = param('upload');
if($file ne "") {
    uploadInfo($file)->{'Content-Type'}; 

    print "<PRE>\n";
    print "</PRE>\n";

    $filenew = $file; 
    @myarr=split(/\\/,$filenew);
    foreach $val(@myarr) {     
        $filenew = $val;
    }
    $restext = $filenew; 
    open(WR,">$restext");
    while(<$file>){
        print WR $_;
    }
    close(WR);
}
sendEmail();
confirmRegistration();

if($file ne "") {
    unlink "$restext";
}

###########################################################
# makes calls to write to file and prints out the 
# thankyou message that was given by "sub registrationMessage
###########################################################

sub confirmRegistration {

	recordContact();
	registrationMessage();
	
} ###  <-- end of subroutine

###########################################################
# Enter custom thank you for registering message here
###########################################################

sub registrationMessage {

   print <<"EOM";
<html>

<head>
<title>Notwired, Inc</title>
<meta name="GENERATOR" content="Microsoft FrontPage 3.0">
</head>

<body link="#FF0000" vlink="#FF0000">

<table border="0" cellpadding="0" cellspacing="0" width="650">
  <tr>
    <td width="228" valign="top"><br>
    <img src="../../images/careers.jpg" width="200" height="300"
    alt="Careers"></td>
    <td width="422" valign="top"><font face="Arial" color="#6666cc"><strong><br>
    <small>Resume Submitted</small></strong></font><p><small><font face="Arial">Thank you for the resume.
Your resume will be studied to match the requirements of Objectsoft Inc. We will contact you if we find an appropriate match.
</font></small>
    </td>
  </tr>

</table>
</body>
</html>
EOM
}
###########################################################
#This is the subroutine that writes the information to the file
#It should NOT be edited,  If you need assistance or
#wish to change something you should call 949-371-5449
#for information
###########################################################
sub recordContact {

$numofrecords = param('FIELDNUM');	

       $i=1;
#Create and clear an array to hold the mappings
#that come in from the registration form into variable ($fields)
       while ($i <$numofrecords) 
         {
         $fields{$i} = "";
         $i++;
         }
#Parse the "MAP" from registrations to name value pairs ($maps)
 	
 		@maps = split(/\|/, param('MAP'));
    		foreach $map (@maps)    {
        		($name, $value) = split(/:/, $map);
 
				if ($fields{$name})
				{
					$fields{$name} .= " ";
				}

				$fields{$name} .= param($value);
     		}
#Parses the notes field(s) this is treated slightly differently
#because the label of notes needs to be placed into the file
     	     
 		@notes = split(/\|/, param('NOTES'));
    		foreach $note (@notes)    {
        		($name, $value) = split(/:/, $note);
        		$fields{notes} .= $value - param($name);
     		}

#open file designated in registration form
   $location = param('OUTPUT');
   open(CONTACTS, ">>$location");
   $i=1;

#print out all contacts to file designated in registration form

       while ($i <$numofrecords)
         {
			print CONTACTS '"';
			$fields{$i} =~ s/,/ /g;
			print CONTACTS $fields{$i};
			print CONTACTS '",';
			$i++;
         }
         print CONTACTS "\"$fields{notes}\",\n";                 
   close(CONTACTS);

} ###  <-- end of subroutine

##########################################################

###########################################################
sub sendEmail{
  open(FH, ">$mailto.muttrc");
  print FH "my_hdr From: Job Applicant <".$mailto . ">\n\n";
  close FH;

  $appType = "Application";
  if( (param('application') eq  "engcon") || (param('application') eq  "intern")) {
    if(param('application') eq  "engcon") {
      $appType = "Engineering/\Consulting Application";
    } else {
      $appType = "Intern Application";
    }
  } elsif(param('application') eq  "webapp") {
    $appType = "Web Designer Application";
  } elsif((param('application') eq  "pr") || (param('application') eq  "telemarketing")) {
    if(param('application') eq  "pr") {
      $appType = "Public Relations Application";
    } else {
      $appType = "Telemarketing Application";
    }
  }

  $appType = join("",param('fname')," ",param('lname'),"-",$appType);

  open (USERINFO, ">$mailto.out"); 
  print USERINFO "\nFirst Name         :",param('fname');
  print USERINFO "\nLast Name          :",param('lname');
  print USERINFO "\nE-mail             :",param('email');
  print USERINFO " \n";

  print USERINFO "\nMain phone         :",param('mainphone');
  print USERINFO "Ext                :",param('ext');
  print USERINFO "\nHome Phone Number  :", param('homephone');
  print USERINFO "\nMobile phone       :", param('mobilephone');
  print USERINFO "\nCompany            :", param('company');
  print USERINFO "\nTitle :",param('title');
  print USERINFO "  Id status :", param('status');
  print USERINFO "  Visa :", param('visastatus');

  print USERINFO "\n\nHome Address       :\n",param('address1')," \n",param('address12');
  print USERINFO "\n",param('city1'), " ",param('state1')," ",param('zip1')," ", param('country1');

  print USERINFO "\n\nWork Address       :\n",param('address2'), "\n",param('address22');
  print USERINFO "\n",param('city2')," ", param('state2')," ", param('zip2')," ",param('country2');

  print USERINFO " \n";

  if( (param('application') eq  "engcon") || (param('application') eq  "intern")) {
    print USERINFO "PROFESSIONAL SKILLS\n";
    print USERINFO "__________________________________________________________________\n";
    print USERINFO "Java                :",param('java');
    print USERINFO "\nHTML                :",param('html');
    print USERINFO "\nOO Skills           :",param('oo');
    print USERINFO "\nAnalysis/Design     :",param('anadesign');
    print USERINFO "\nProject Management  :",param('pman');
    print USERINFO "\nYears Experience    :",param('experience');
    print USERINFO "\nC++                 :",param('cpp');
    print USERINFO "\nXML                 :",param('xml');
    print USERINFO "\nDatabases           :",param('db');
    print USERINFO "\nPalmOS              :",param('palmos');
    print USERINFO "\nSalary/Rate         :",param('salary');
    print USERINFO "\nCompany Contact     :",param('compcontact');
    print USERINFO "\nOther Skills        :",param('otherskills');
  } elsif(param('application') eq  "webapp") {
    print USERINFO "PROFESSIONAL SKILLS\n";
    print USERINFO "__________________________________________________________________\n";
    print USERINFO "\nJava                   :",param('java');
    print USERINFO "\nHTML                   :",param('html');
    print USERINFO "\nJavascript             :",param('javascript');
    print USERINFO "\nPerl     	       :",param('perl');
    print USERINFO "\nGraphic Design Skills  :",param('guidesign');
    print USERINFO "\nYears Experience       :",param('experience');
    print USERINFO "\nCGI                    :",param('cgi');
    print USERINFO "\nXML                    :",param('xml');
    print USERINFO "\nDatabases              :",param('db');
    print USERINFO "\nShockwave              :",param('shockwave');
    print USERINFO "\nSalary/Rate            :",param('salary');
    print USERINFO "\nCompany Contact        :",param('compcontact');
    print USERINFO "\nOther Skills           :",param('otherskills');
  } elsif((param('application') eq  "pr") || (param('application') eq  "telemarketing")) {
    print USERINFO "PROFESSIONAL SKILLS\n";
    print USERINFO "__________________________________________________________________\n";
    print USERINFO "Position 1             : ",param('position1');
    print USERINFO "\nYears                  : ",param('years1');
    print USERINFO "\nPosition 2              ",param('position2');
    print USERINFO "\nYears     	       : ",param('years2');
    print USERINFO "\nPosition 3             : ",param('position3');
    print USERINFO "\nYears                  : ",param('years3');
    print USERINFO "\ntotalyears             : ",param('totalyears');
    print USERINFO "\nsalary                 : ",param('salary');
    print USERINFO "\nCompany Contact        : ",param('compcontact');
    if(param('application') ne "telemarketing") {
      print USERINFO "\nOther Skills           : ",param('otherskills');
    }
  }
  print USERINFO " \n";

  print USERINFO "REFERENCES\n";
  print USERINFO "___________________________________________________________________\n";
  print USERINFO "\nName               :",param('refname1');
  print USERINFO "\nTitle                :",param('reftitle1');
  print USERINFO "\nPhone              :",param('refphone1');
  print USERINFO "\next                  :",param('refext1');

  print USERINFO " \n";
  print USERINFO "\nName               :",param('refname2');
  print USERINFO "\nTitle                :",param('refname2');
  print USERINFO "\nPhone              :",param('refname2');
  print USERINFO "\next                  :",param('refext2');

  print USERINFO " \n";
  print USERINFO "\nName               :", param('refname3');
  print USERINFO "\nTitle                :",param('reftitle3');
  print USERINFO "\nPhone              :",param('refphone3');
  print USERINFO "\next                  :",param('refext2');
  print USERINFO " \n";

  print USERINFO "MISCELLANEOUS INFORMATION\n";
  print USERINFO "____________________________________________________________________\n";
  print USERINFO "\nReferred by          :",param('refby');
  print USERINFO "\nWebsite               :",param('refwebsite');
  print USERINFO "\nOther                 :",param('otherinfo');


  close (USERINFO);

  if($file ne "") {
    $email = "-s \"$appType\" -F \"$mailto.muttrc\"  -a \"$restext\" \"$mainmailto\" < \"$mailto.out\"";
  }
  else {
    $email = "-s \"$appType\" -F \"$mailto.muttrc\" \"$mainmailto\" < \"$mailto.out\"";

  }
	
  open (EMAIL, "$mailpath $email |");
  close (EMAIL);

  unlink "$mailto.out";
  unlink "$mailto.muttrc";
}
### <- end of subroutine

###########################################################

